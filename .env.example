#AWS configuration
AWS_ACCESS_KEY_ID="your aws access key id"
AWS_SECRET_ACCESS_KEY="your aws secret access key"
AWS_REGION="ap-southeast-2"
S3_BUCKET=oc-enterprise-ai-26

#bedrock model configuration
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

#pinecone vectordatabase configuration
PINECONE_API_KEY="your pinecone api key"
PINECONE_INDEX_HOST="oc-enterprise-ai-index"
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

#postgresql database configuration
DATABASE_URL=your postgresql database url

#RIUS observability configuration
RIUS_API_KEY="your rius api key"
RIUS_SERVICE_NAME=oc-ai-enterprise
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false
